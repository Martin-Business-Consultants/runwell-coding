<% @page_title = "Code" %>
<%= render "settings/header", current: :coding %>

<div class="code-page">
  <%= ui :card, title: tag.h2("GitHub", class: "code-title") do %>
    <p class="code-line">
      <% if @connection.connected? %>
        <%= status_tag "Active" %>
        <span>Connected as @<%= @connection.login %><%= " since " + l(@connection.connected_at.to_date, format: :long) if @connection.connected_at %>. Runwell reads pull requests, checks, deploys, issues and who can reach a repository. It never pushes code.</span>
      <% else %>
        <%= status_tag "Dormant" %>
        <span>Not connected: <%= @connection.blocker %>. Repositories work without it; you just don’t get pull requests, checks and deploys.</span>
      <% end %>
    </p>

    <% if @connection.last_error.present? %>
      <%= ui :alert, variant: :destructive, title: "The last sync went wrong", description: @connection.last_error %>
    <% end %>
    <% if @connection.last_synced_at %>
      <p class="code-meta">Last sync <%= time_ago_in_words(@connection.last_synced_at) %> ago.</p>
    <% end %>

    <div class="code-buttons">
      <% if @connection.configured? %>
        <%= button_to coding_authorization_path, class: "ui-button", form: { data: { turbo: false } } do %>
          <%= icon_tag "globe" %>
          <span><%= @connection.connected? ? "Reconnect with GitHub" : "Sign in with GitHub" %></span>
        <% end %>
      <% end %>
      <% if @connection.connected? %>
        <%= button_to coding_sync_path, class: "ui-button", data: { variant: "outline" } do %>
          <%= icon_tag "refresh" %>
          <span>Sync now</span>
        <% end %>
        <%= render "layouts/shared/confirm", trigger: "Disconnect", title: "Disconnect GitHub?",
              body: "Runwell stops hearing from GitHub and gives up its access there. Linked repositories, branches and history stay.",
              button: "Disconnect", path: coding_settings_path, icon: "remove" %>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @connection, url: coding_settings_path, method: :patch, scope: :connection, class: "code-page" do |form| %>
    <%= ui :card, title: tag.h2("Credentials and behaviour", class: "code-title"),
          description: "Your own GitHub OAuth app (GitHub › Settings › Developer settings › OAuth Apps). Set its callback URL to #{coding_authorization_url}" do %>
      <div class="code-form__pair">
        <%= form.ui :field, :client_id, label: "OAuth client id" do %>
          <%= form.ui :input, :client_id, autocomplete: "off" %>
        <% end %>
        <%= form.ui :field, :client_secret, label: "OAuth client secret" do %>
          <%= secret_field form, :client_secret %>
        <% end %>
      </div>
      <%= form.ui :field, :issue_label, label: "Issues with this label become requests", description: "They come into Intake, credited to whoever opened them on GitHub." do %>
        <%= form.ui :input, :issue_label, autocomplete: "off", placeholder: "client" %>
      <% end %>
      <%= switch_field form, :close_work_on_merge, label: "A merged pull request marks its #{term(:task).downcase} done", hint: "Otherwise it stays in review for a person to mark done." %>
      <div><%= ui :button, type: :submit, content: "Save" %></div>
    <% end %>
  <% end %>

  <% if @connection.persisted? %>
    <%= ui :card, title: tag.h2("Webhook", class: "code-title"),
          description: "Add it from a repository’s panel, or once for your whole GitHub organization (Settings › Webhooks, content type JSON, every event). GitHub must be able to reach this address, so a local install needs a tunnel." do %>
      <div class="code-copy">
        <%= ui :input, value: coding_github_webhooks_url, readonly: true, aria: { label: "Webhook URL" }, class: "code-copy__input" %>
        <%= ui :button, variant: :outline, content: "Copy URL",
              data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: coding_github_webhooks_url, copy_to_clipboard_success_class: "code-copied", action: "copy-to-clipboard#copy" } %>
      </div>
      <div class="code-copy">
        <%= ui :input, value: "Secret: ••••••••", readonly: true, aria: { label: "Webhook secret, hidden" }, class: "code-copy__input" %>
        <%= ui :button, variant: :outline, content: "Copy secret",
              data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: @connection.webhook_secret, copy_to_clipboard_success_class: "code-copied", action: "copy-to-clipboard#copy" } %>
      </div>
    <% end %>
  <% end %>

  <%= ui :card, title: tag.h2("GitHub usernames", class: "code-title"), description: "Matches commits, reviews and repository access to people. Anyone can set their own on Code › Time from commits." do %>
    <ul class="code-list code-list--scroll">
      <% @people.each do |person| %>
        <%# herb:key person.id %>
        <li class="code-row">
          <%= person_tag person %>
          <strong class="code-row__main"><%= person.display_name %></strong>
          <%= form_with url: coding_people_path, method: :patch, scope: :person, namespace: dom_id(person), class: "code-inline-form" do |form| %>
            <%= form.hidden_field :user_id, value: person.id %>
            <%= form.ui :input, :github_login, value: person.coding_identity&.github_login, autocomplete: "off", placeholder: "GitHub username", aria: { label: "GitHub username for #{person.display_name}" } %>
            <%= ui :button, type: :submit, variant: :outline, size: :sm, content: "Save" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= ui :card, title: tag.h2("Linked repositories", class: "code-title") do %>
    <% if @repositories.any? %>
      <ul class="code-list code-list--scroll">
        <% @repositories.each do |repository| %>
          <%# herb:key repository.id %>
          <li class="code-row">
            <%= link_to search_result_path(repository.linkable), class: "code-row__main" do %>
              <strong><%= repository.name %></strong>
              <span class="code-meta"><%= [ repository.client.name, (repository.linked_label unless repository.linkable_type == "Client") ].compact.join(" · ") %></span>
            <% end %>
            <% if repository.github? %>
              <%= ui :badge, variant: (repository.webhook_id ? :success : :outline), content: (repository.webhook_id ? "Webhook" : "No webhook") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "No repository is linked yet. Link one from the quick actions (A) on a #{term(:client).downcase}, #{term(:work).downcase} or #{term(:task).downcase}." %>
    <% end %>
  <% end %>
</div>
