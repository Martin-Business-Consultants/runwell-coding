<%# locals: (record:) %>
<%# The repositories a client, piece of work or task works in: its own, or the ones it inherits
    from above (a task from its work, a piece of work from its client). %>
<% own = record.coding_repositories.ordered.includes(:added_by).to_a %>
<% inherited = own.empty? ? Coding::Repository.for(record) : [] %>
<% connected = Coding::Connection.current&.connected? %>
<%= ui :card, class: "code-card", id: "code", title: tag.h2("Repositories", class: "code-title"),
      description: ("Inherited from #{inherited.first.linked_label}. Link one here to use it instead." if inherited.any?) do %>
  <% if own.any? %>
    <ul class="code-list code-list--spaced">
      <% own.each do |repository| %>
        <%# herb:key repository.id %>
        <li>
          <%= render "coding/repository", repository: repository, connected: connected %>
        </li>
      <% end %>
    </ul>
  <% elsif inherited.any? %>
    <ul class="code-list">
      <% inherited.each do |repository| %>
        <%# herb:key repository.id %>
        <li class="code-row">
          <%= link_to repository.web_url, class: "code-row__main", target: "_blank", rel: "noopener" do %>
            <strong><%= repository.name %></strong>
            <span class="code-meta"><%= [ repository.default_branch, repository.path ].compact.join(" · ") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= ui :empty, size: :sm, description: "No repository yet. Link one from the quick actions (A), under Repository." %>
  <% end %>
<% end %>
