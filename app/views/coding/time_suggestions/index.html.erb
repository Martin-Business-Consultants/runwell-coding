<% @page_title = "Time from commits" %>
<%= render "coding/nav", current: :time %>
<%= ui :page_header, title: @page_title, description: "Time worth logging, worked out from the commits you pushed to a #{term(:task).downcase}’s branch. Nothing is logged until you say so." %>

<div class="code-page">
  <% unless @time_tracking %>
    <%= ui :alert, title: "Time tracking is off", description: "Switch it on in Settings › Plugins to log these." %>
  <% end %>

  <%= ui :card, title: tag.h2("Suggested for you", class: "code-title") do %>
    <% if @suggestions.any? %>
      <ul class="code-list">
        <% @suggestions.each do |suggestion| %>
          <%# herb:key suggestion.id %>
          <li class="code-row">
            <div class="code-row__main">
              <span><strong><%= code_duration suggestion.minutes %></strong> <%= suggestion.task.title %></span>
              <span class="code-meta"><%= [ l(suggestion.date, format: :short), suggestion.task.work&.title || suggestion.task.client&.name, suggestion.note ].compact.join(" · ") %></span>
            </div>
            <% if @time_tracking %>
              <%= button_to "Log", coding_time_suggestions_path, params: { suggestion: suggestion.id }, class: "ui-button", data: { size: "sm" } %>
            <% end %>
            <%= button_to "Dismiss", coding_time_dismissal_path, params: { suggestion: suggestion.id }, class: "ui-button", data: { variant: "ghost", size: "sm" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "Nothing to suggest. Commits pushed to a #{term(:task).downcase}’s branch show up here, matched by your GitHub username." %>
    <% end %>
  <% end %>

  <%= ui :card, title: tag.h2("Your GitHub username", class: "code-title"), description: "Matches your commits, reviews and repository access to you." do %>
    <%= form_with url: coding_identity_path, method: :patch, scope: :identity, class: "code-inline-form" do |form| %>
      <%= form.ui :input, :github_login, value: Current.user.person.coding_identity&.github_login, autocomplete: "off", placeholder: "octocat", aria: { label: "GitHub username" } %>
      <%= ui :button, type: :submit, variant: :outline, content: "Save" %>
    <% end %>
  <% end %>
</div>
