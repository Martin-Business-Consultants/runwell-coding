<% @page_title = "Work on #{@task.title}" %>
<% workspace = @workspace %>
<%= parent_page @task.title, task_path(@task) %>
<%= ui :page_header, title: @page_title, description: "Clone the code onto the task’s branch, then work against what its #{term(:work).downcase} delivers." %>

<div class="code-page code-page--split">
  <%= ui :card, title: tag.h2("Clone and start", class: "code-title"), description: ("Branch #{workspace.branch_name}" if workspace.repositories.any?) do %>
    <% if workspace.repositories.any? %>
      <% workspace.repositories.each do |repository| %>
        <%# herb:key repository.id %>
        <% commands = workspace.clone_commands(repository).join("\n") %>
        <section class="code-stack">
          <div class="code-row">
            <strong class="code-row__main"><%= repository.name %></strong>
            <%= ui :button, variant: :outline, size: :sm, content: "Copy commands",
                  data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: commands, copy_to_clipboard_success_class: "code-copied", action: "copy-to-clipboard#copy" } %>
          </div>
          <%= code_block commands %>
          <% if repository.setup_notes.present? %>
            <div class="code-notes"><%= rich_text repository.setup_notes %></div>
          <% end %>
        </section>
      <% end %>
    <% else %>
      <%= ui :empty, size: :sm, description: "No repository on this #{term(:task).downcase}, its #{term(:work).downcase} or its #{term(:client).downcase} yet. Link one from the quick actions (A)." %>
    <% end %>
  <% end %>

  <div class="code-page">
    <%= ui :card, title: tag.h2("What it delivers", class: "code-title") do %>
      <% sections = workspace.sections %>
      <% if sections.any? %>
        <ul class="code-bullets">
          <% sections.each do |section| %>
            <%# herb:key section.id %>
            <li><%= section.description %><%= " (this #{term(:task).downcase})" if section.id == @task.scope_item_id %></li>
          <% end %>
        </ul>
      <% else %>
        <%= ui :empty, size: :sm, description: "No #{term(:scope_item, count: 2).downcase} yet." %>
      <% end %>
      <% if @task.description.present? %>
        <div class="code-notes"><%= rich_text @task.description %></div>
      <% end %>
    <% end %>

    <% dated = workspace.dated_tasks.to_a %>
    <% if dated.any? %>
      <%= ui :card, title: tag.h2("Due around it", class: "code-title") do %>
        <ul class="code-list">
          <% dated.each do |task| %>
            <%# herb:key task.id %>
            <li class="code-row">
              <%= side_panel_link_to task, class: "code-row__main" do %>
                <strong><%= task.title %></strong>
                <span class="code-meta"><%= task.owner&.display_name || "Unassigned" %> · due <%= l task.due_on, format: :short %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
