<%# locals: (repository:, connected:) %>
<%# One linked repository: its name, branch and where it runs; setup notes in two lines at most;
    its latest deploys; then a row of tools (the clone command and copy, deploys shown to the
    client, the webhook, unlink, edit). Editing opens under the tools. %>
<div class="code-repo">
  <div class="code-row">
    <%= link_to repository.web_url, class: "code-row__main", target: "_blank", rel: "noopener",
          title: [ repository.url, ("linked by #{repository.added_by.display_name}" if repository.added_by) ].compact.join(" · ") do %>
      <strong><%= repository.name %></strong>
      <span class="code-meta"><%= [ repository.default_branch, repository.path ].compact.join(" · ") %></span>
    <% end %>
    <% if repository.staging_url %>
      <%= ui :button, href: repository.staging_url, variant: :outline, size: :sm, content: "Staging", target: "_blank", rel: "noopener", title: repository.staging_url %>
    <% end %>
    <% if repository.production_url %>
      <%= ui :button, href: repository.production_url, variant: :outline, size: :sm, content: "Production", target: "_blank", rel: "noopener", title: repository.production_url %>
    <% end %>
  </div>

  <% if repository.setup_notes.present? && ActionText::Content.new(repository.setup_notes).to_plain_text.strip.present? %>
    <div class="code-repo__notes"><%= rich_text repository.setup_notes %></div>
  <% end %>

  <% repository.latest_deploys.each do |deploy| %>
    <%# herb:key deploy.id %>
    <p class="code-line">
      <%= status_tag deploy.succeeded? ? "Done" : deploy.state.humanize %>
      <span class="code-meta"><%= deploy.environment %> · <%= deploy.sha.to_s.first(7) %> · <%= time_ago_in_words(deploy.deployed_at) %> ago</span>
    </p>
  <% end %>

  <div class="code-repo__tools">
    <code class="code-repo__clone" title="git clone <%= repository.url %>">git clone <%= repository.url %></code>
    <%= ui :button, variant: :ghost, size: :icon_sm, title: "Copy the clone command", aria: { label: "Copy the clone command" }, content: icon_tag("clipboard"),
          data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: "git clone #{repository.url}", copy_to_clipboard_success_class: "code-copied", action: "copy-to-clipboard#copy" } %>
    <% if repository.github? %>
      <% if repository.share_deploys %>
        <%= button_to coding_repository_deploy_sharing_path(repository), method: :delete, class: "ui-button", data: { variant: "secondary", size: "icon-sm" },
              title: "Deploys show in the client portal. Click to hide them.", aria: { label: "Hide deploys from the client" } do %>
          <%= icon_tag "share" %>
        <% end %>
      <% else %>
        <%= button_to coding_repository_deploy_sharing_path(repository), class: "ui-button", data: { variant: "ghost", size: "icon-sm" },
              title: "Show deploys in the client portal", aria: { label: "Show deploys to the client" } do %>
          <%= icon_tag "share" %>
        <% end %>
      <% end %>
      <% if connected && repository.webhook_id.nil? %>
        <%= button_to coding_repository_hook_path(repository), class: "ui-button", data: { variant: "ghost", size: "icon-sm" },
              title: "Add the GitHub webhook (pull requests, checks, deploys)", aria: { label: "Add the GitHub webhook" } do %>
          <%= icon_tag "bolt" %>
        <% end %>
      <% end %>
    <% end %>
    <% if repository.deletable_by?(Current.user) %>
      <%= render "layouts/shared/delete_dialog", name: "the link to #{repository.name}", path: coding_repository_path(repository),
            message: "It’s only unlinked here. Nothing changes in the repository." %>
    <% end %>
  </div>

  <%= ui :collapsible, class: "code-repo__edit", trigger: "Edit setup and environments" do %>
    <%= form_with model: repository, url: coding_repository_path(repository), method: :patch, scope: :repository, namespace: dom_id(repository), class: "code-form" do |form| %>
      <%= render "coding/repository_fields", form: form %>
      <div><%= ui :button, type: :submit, size: :sm, content: "Save" %></div>
    <% end %>
  <% end %>
</div>
